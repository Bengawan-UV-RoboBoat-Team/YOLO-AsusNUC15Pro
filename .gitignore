# Python
.venv/
__pycache__/
*.pyc

# Downloaded weights & exported models
models/**
!models/.gitkeep

# Dataset cache
data/**
!data/.gitkeep

# Raw per-run results (keep the aggregated summary CSV tracked)
results/raw/**
!results/raw/.gitkeep

# Stray checkpoints / exports if ultralytics is run outside the benchmark
*.pt
*_openvino_model/
results/runs/
*.egg-info/

# Dumped by the Intel GPU kernel compiler on driver-side compile errors
kernel.errors.txt
